# ==============================================================================
# ThinStation 7.2 Build-Time Configuration
# Сервер VDI: vdi.dnestrschool1.online (VMware / Omnissa Horizon)
# ==============================================================================

# --- Настройки сессии Omnissa / VMware Horizon ---
SESSION_0_TITLE="VDI"
SESSION_0_TYPE=horizon
SESSION_0_AUTOSTART=On
SESSION_0_HORIZON_SERVER="VDI"
SESSION_0_HORIZON_SERVERURL="https://vdi.dnestrschool1.online"
SESSION_0_HORIZON_FULLSCREEN=true
SESSION_0_HORIZON_NONINTERACTIVE=false

# --- Глобальные параметры клиента Horizon (Автоподключение и SSL) ---
# Жестко фиксирует адрес сервера по умолчанию в настройках Horizon Client:
HORIZON_DEFAULTBROKER="https://vdi.dnestrschool1.online"
# Автоматическое подключение к серверу без необходимости кликать на плитку сервера:
HORIZON_AUTOCONNECT=TRUE
# Режим проверки SSL (3 = не прерывать подключение из-за сбоя сертификата/рассинхронизации часов):
HORIZON_SSLVERIFYMODE=3

# --- Настройки звука ---
AUDIO_LEVEL=85
MIC_LEVEL=50

# --- Язык и раскладка клавиатуры ---
# Переключение раскладки: Alt + Shift, индикация на ScrollLock
KEYBOARD_MAP=ru
XKEYBOARD="us,ru"
XKBVARIANT=","
XKBOPTIONS="grp:alt_shift_toggle,grp_led:scroll"
LOCALE=ru_RU

# --- Разрешение экрана и оконный менеджер ---
SET_RESOLUTION_MULTIMONITOR_EXPAND='mirror'
SET_RESOLUTION_MULTIMONITOR_AUTOSCALE='scale'
DESKTOP_ICON_SIZE=48
GTK_THEME=Adwaita
XFWM4_THEME=Default
PANEL_PAGER=false
PANEL_USER=false
PANEL_REV_CLOCKSYSTRAY=true

# --- Сеть и синхронизация времени (NTP) ---
NET_USE=BOTH
NET_USE_DHCP=on
NET_HOSTNAME=ts-*
TIME_ZONE=Europe/Chisinau
NET_TIME_SERVER=pool.ntp.org

# Опционально: если требуется настроить бесшовное автоподключение к известной сети Wi-Fi,
# раскомментируйте следующие строки и укажите SSID и пароль:
# WIRELESS_ESSID="Ваш_WiFi_SSID"
# WIRELESS_WPAKEY="Ваш_WiFi_Пароль"

# --- Проброс и монтирование USB флеш-накопителей ---
USB_STORAGE_SYNC=on
BIND_MOUNT0="storage:/mnt/storage"
STORAGE_CONFIG1=/mnt/storage

# --- Метки томов накопителей для загрузки ---
HDVOLNAME=THINSTATION
CDVOLNAME=THINSTATION
