# ==============================================================================
# ThinStation 6.2 Build-Time Configuration
# Сервер VDI: vdi.dnestrschool1.online (VMware Horizon View)
# ==============================================================================

# --- Настройки сессии VMware View ---
SESSION_0_TITLE="VDI"
SESSION_0_TYPE=vmview
SESSION_0_AUTOSTART=On
SESSION_0_VMVIEW_SERVER="VDI"
SESSION_0_VMVIEW_SERVERURL="https://vdi.dnestrschool1.online"
SESSION_0_VMVIEW_FULLSCREEN=true

# Глобальные параметры клиента Horizon View
VMVIEW_DEFAULTBROKER="https://vdi.dnestrschool1.online"
VMVIEW_AUTOCONNECT=TRUE
VMVIEW_SSLVERIFYMODE=3

# --- Настройки звука ---
AUDIO_LEVEL=85
MIC_LEVEL=50

# --- Язык и раскладка клавиатуры ---
KEYBOARD_MAP=ru
XKEYBOARD="us,ru"
XKBVARIANT=","
XKBOPTIONS="grp:alt_shift_toggle,grp_led:scroll"
LOCALE=ru_RU

# --- Разрешение экрана и графическая оболочка ---
SET_RESOLUTION_MULTIMONITOR_EXPAND='mirror'
SET_RESOLUTION_MULTIMONITOR_AUTOSCALE='scale'
DESKTOP_ICON_SIZE=48
GTK_THEME=Adwaita
XFWM4_THEME=Default

# --- Сеть и синхронизация времени (NTP) ---
NET_USE=BOTH
NET_USE_DHCP=on
NET_HOSTNAME=ts-*
TIME_ZONE=Europe/Chisinau
NET_TIME_SERVER=pool.ntp.org

# --- Проброс и монтирование USB флеш-накопителей ---
USB_STORAGE_SYNC=on
BIND_MOUNT0="storage:/mnt/storage"
STORAGE_CONFIG1=/mnt/storage
